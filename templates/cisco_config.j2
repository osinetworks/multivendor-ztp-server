! ============================================================
! Cisco IOS XE Configuration Template
! Generated by generate_generic_config.py
!
! Addresses come from inventory.yaml in CIDR form (172.18.10.11/24).
! IOS wants 'ip address <addr> <mask>', so every address goes through
! the ip_and_mask filter — writing the raw inventory value produces a
! config the switch rejects.
! ============================================================
hostname {{ hostname }}
!
no service config
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
! Password hashes: IOS XE accepts type 5 ($1$), type 8 ($8$) and type 9 ($9$).
! The Arista-side hashes in config.yaml are SHA-512 crypt ($6$, from
! 'openssl passwd -6'). IOS does NOT reject those loudly — it does something
! worse: it treats the unrecognised string as a CLEARTEXT password and hashes
! it, silently setting the login password to the literal hash text. So there is
! deliberately no fallback here; the generator refuses to render a cisco_ios
! switch whose vars file has no cisco_* hashes.
username admin privilege 15 secret {{ cisco_admin_password_hash }}
{% if custom_username is defined and custom_username %}
username {{ custom_username }} privilege 15 secret {{ cisco_custom_user_password_hash }}
{% endif %}
!
{% if cisco_enable_password_hash is defined and cisco_enable_password_hash %}
enable secret {{ cisco_enable_password_hash }}
{% endif %}
!
clock timezone {{ timezone }}
!
{% for ntp in ntp_servers | default([]) %}
ntp server {{ ntp.ip }}{% if ntp.prefer | default(false) %} prefer{% endif %}
{% endfor %}
!
! Out-of-band management port (GigabitEthernet0/0 on the Catalyst 9000
! family). Only addressed when the inventory gives this switch a distinct
! OOB address — the generator blanks mgmt_ip when it merely repeats the
! in-band SVI address.
interface {{ cisco_mgmt_interface | default('GigabitEthernet0/0') }}
 description OOB Management
 vrf forwarding {{ cisco_mgmt_vrf | default('Mgmt-vrf') }}
{% if mgmt_ip %}
 ip address {{ mgmt_ip | ip_and_mask }}
{% else %}
 ip address dhcp
{% endif %}
 no shutdown
!
{% if mgmt_svi_ip_address %}
vlan {{ mgmt_svi_vlan | default(10) }}
 name {{ mgmt_svi_name | default('MGMT_SVI') }}
!
! In-band management SVI, in the global routing table.
interface Vlan{{ mgmt_svi_vlan | default(10) }}
 description MGMT SVI
 ip address {{ mgmt_svi_ip_address | ip_and_mask }}
 no shutdown
!
{% endif %}
ip routing
!
{% if inband_gateway is defined and inband_gateway %}
ip route 0.0.0.0 0.0.0.0 {{ inband_gateway | ip_only }}
{% endif %}
{% if mgmt_gateway is defined and mgmt_gateway %}
ip route vrf {{ cisco_mgmt_vrf | default('Mgmt-vrf') }} 0.0.0.0 0.0.0.0 {{ mgmt_gateway | ip_only }}
{% endif %}
!
ip domain name {{ domain_name | default('local') }}
! NOTE: 'crypto key generate rsa' is an EXEC command and is rejected inside a
! startup-config. IOS XE generates the host key automatically on first boot
! once a hostname and domain name are set, which both happen above.
ip ssh version 2
!
line con 0
 logging synchronous
 login local
!
line vty 0 15
 login local
 transport input ssh
!
end
